# Copy to supabase/.env (gitignored) for real email delivery from the local stack.
# SMTP_USER: the Gmail address that sends PataStay emails.
# SMTP_PASS: a Gmail App Password (16 letters, no spaces), NOT your normal password.
#            Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
SMTP_USER=your.address@gmail.com
SMTP_PASS=
